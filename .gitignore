.env
secrets.env
*.local

# Per-stage env files carry real (non-secret) instance facts — hostnames both
# the browser and a container must resolve identically (KEYCLOAK_PUBLIC_URL
# etc., docker-compose.yml). Not credentials, but instance-specific, so ALL
# per-stage files (staging/test/prod) are gitignored like secrets.env;
# env/environment.env.example is the single committed template, and
# env/base.env (stage-independent, no instance facts) stays committed.
env/*.env
!env/base.env

# Local/private runtime state.
data/*
!data/.gitkeep

# Local scratch.
tmp/
.claude/settings.*
