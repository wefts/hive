.env
secrets.env
# Any sibling of it too: a backup or a .bak left during a migration carries
# the same live credentials, and only the exact name was ignored before.
secrets.env.*
!secrets.env.example
*.local

# Per-stage env files carry real (non-secret) instance facts — hostnames both
# the browser and a container must resolve identically (KEYCLOAK_PUBLIC_URL
# etc., docker-compose.yml). Not credentials, but instance-specific, so ALL
# per-stage files (staging/test/prod) are gitignored like secrets.env;
# env/environment.env.example is the single committed template, and
# env/base.env (stage-independent, no instance facts) stays committed.
env/*.env
!env/base.env

# Curated who-map group overlay: real per-stage defs (real slugs + uid overrides) stay out of the
# public repo; the generic template stays committed.
env/groups.*.yaml
!env/groups.example.yaml
env/services.*.yaml
!env/services.example.yaml
env/ldap_schema.*.yaml
!env/ldap_schema.example.yaml

# Local/private runtime state.
data/*
!data/.gitkeep

# Local scratch.
tmp/
.claude/settings.*

# Internal PKI trust material. Not secret, but it advertises internal
# infrastructure and this repo is public.
certs/
