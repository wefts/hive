# SECRET keys (values empty). Copy to `secrets.env`, fill, and keep it OUT of
# every repo and every sync. `secrets.env` is excluded by deploy.sh and lives
# in exactly one place per machine (workspace root). Never echo into logs/tmp.
#
# On Spark you MAY instead point SWARM_SECRETS_ENV at an existing outside-repo
# file rather than copying values anywhere.

# --- Confluence ---
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=

# --- MediaWiki ---
WIKI_URL=
WIKI_USER=
WIKI_USER_TOKEN=
WIKI_ALT_USERNAME=
WIKI_ALT_TOKEN=

# --- web_channel (P1 identity) ---
# Local dev uses safe compose fallbacks; set these for a shared/prod deploy.
# SESSION_SECRET signs the session cookie (which carries authorization) — MUST be a
# strong random value in prod; empty ⇒ the app mints an ephemeral per-boot key.
WEB_CHANNEL_SESSION_SECRET=
# The Keycloak OIDC confidential-client secret (real value from the org's vault when
# pointing at the org's real Keycloak realm; local dev uses the realm-import default).
WEB_CHANNEL_OIDC_SECRET=
# Keycloak admin password (local dev defaults to admin/admin in compose).
KEYCLOAK_ADMIN_PASSWORD=

# --- Verified actor assertion (ADR-16 Decision 9, step 6b) ---
# The SAME value is read by BOTH the kernel and web_channel (docker-compose.yml) —
# it is the shared HMAC key for the HS256 actor assertion the channel signs and the
# kernel verifies. >= 32 random bytes (e.g. `openssl rand -base64 32`). Empty on
# either side ⇒ that side treats signing/verification as a no-op — the pre-6b legacy
# plaintext-viewer path keeps working, dual-accept, until both sides are set.
SWARM_ACTOR_SECRET=

# --- web_channel / Keycloak public hostnames (hive-publish-readiness-audit) ---
# NOT secrets — but REQUIRED (no compose default) because there is no safe generic
# value: the OIDC issuer must be a hostname both the browser AND the web_channel
# container can resolve to the SAME thing (the "dev split-horizon" trick — see
# docker-compose.yml). Reusing this gitignored file pragmatically rather than
# inventing a second private-but-non-secret config layer. Set all three to the
# same real host (e.g. your machine's real hostname/IP on the network you access
# it from) + the published ports:
KEYCLOAK_PUBLIC_URL=
WEB_CHANNEL_PUBLIC_URL=
KEYCLOAK_PUBLIC_HOST=
