# secrets.env.example — the SHAPE of hive/secrets.env, never its contents.
#
# Generated with every value removed AND comments redacted: on 2026-09-03 a
# commented-out block carried a private address and a token id into this
# file, because stripping KEY=value is not the same as removing data.
#
# Copy to secrets.env and fill it in. If you add a key there, add it here.

# SECRET keys (values empty). Copy to `secrets.env`, fill, and keep it OUT of
# every repo and every sync. `secrets.env` is excluded by deploy.sh and lives
# in exactly one place per machine (workspace root). Never echo into logs/tmp.
#
# On Spark you MAY instead point SWARM_SECRETS_ENV at an existing outside-repo
# file rather than copying values anywhere.

# --- Confluence ---
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=

# --- MediaWiki ---
WIKI_URL=
WIKI_USER=
WIKI_USER_TOKEN=
WIKI_ALT_USERNAME=
WIKI_ALT_TOKEN=

SWARM_ACTOR_SECRET=
SWARM_KERNEL_DB_USER=
SWARM_KERNEL_DB_PASSWORD=

# --- Proxmox: live infrastructure, one cluster per datacenter ---------------
#
# The site key is DATA, not an index. It becomes the scope of every fact
# ingested from that cluster, so `mpl` and `casa` can both hold a host called
# `web-01` without the two ever merging. Never renumber these; renaming a site
# key rewrites the identity of everything it ingested.
#
# Adding a datacenter = add its key to PROXMOX_SITES and the three vars below.
# A key listed here without its vars must fail loudly at startup, not be
# skipped quietly — a silently absent datacenter looks exactly like a
# datacenter with nothing in it.
#
# Each site gets its OWN scheduled ingest job (ADR-21 shape). One unreachable
# datacenter must not stop the others, and their schedules are independent.
#
# Tokens must be read-only: a dedicated API user with role PVEAuditor, not a
# personal account. Swarm never writes to Proxmox.
#
# Guessed from the existing graph (net:cluster:mpl / idf / casa) — correct this
# list to the real set of Proxmox clusters.
# Trimmed to the reachable sites 2026-09-03. idf and casa keep their
# variables below but stay out of this list: they resolve in DNS and do
# not answer on 8006 or 443 from Spark, so listing them only produces a
# failing job per cycle. Add them back the moment routing is fixed.
PROXMOX_SITES=

PROXMOX_FORGE_URL=
PROXMOX_FORGE_TOKEN_ID=
PROXMOX_FORGE_TOKEN_SECRET=

PROXMOX_GALAXY_URL=
PROXMOX_GALAXY_TOKEN_ID=
PROXMOX_GALAXY_TOKEN_SECRET=

PROXMOX_IDF_URL=
PROXMOX_IDF_TOKEN_ID=
PROXMOX_IDF_TOKEN_SECRET=

# PROXMOX_MPL_URL=<address>
# PROXMOX_MPL_TOKEN_ID=swarm@<token-id>
# PROXMOX_MPL_TOKEN_SECRET=

PROXMOX_CASA_URL=
PROXMOX_CASA_TOKEN_ID=
PROXMOX_CASA_TOKEN_SECRET=

# TLS. Default is verify — an internal CA is a reason to add the CA, not a
# reason to stop checking. Set a PEM path per site only if that cluster uses a
# certificate the system store does not chain to. PROXMOX_TLS_VERIFY=false is
# for a broken-cert emergency and should never be committed as the norm.
PROXMOX_TLS_VERIFY=
PROXMOX_CA_PEM=

# Carried over from the previous Spark copy 2026-09-03; the incoming
# file did not define it.
GEMINI_API_KEY=
