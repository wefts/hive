# Hive config — cross-stage constants (NON-secret, committed).
# Loaded first by `scripts/compose` (ADR-0015); values here apply to every
# SWARM_ENV. Per-stage overrides live in `env/<SWARM_ENV>.env`; real credentials
# live in `secrets.env` (git-ignored, never here). SWARM_DB_NAME is deliberately
# NOT set here — it is derived from SWARM_ENV (`swarm_${SWARM_ENV}`) by
# docker-compose.yml itself, so there is nothing to override by accident.

# --- Postgres (kernel substrate) ---
SWARM_DB_USER=swarm
SWARM_DB_PASSWORD=swarm
SWARM_DB_PORT=5432

# --- Core API (kernel gRPC, published on the host) ---
SWARM_CORE_API_PORT=50061

# --- Registry tier ---------------------------------------------------------
# Where base/runtime images are pulled from. Precedence by intent:
#   local mirror (localhost:5000, fully offline — see docker-compose.offline.yml)
#   → Smile public aliases (defaults below; safe to commit; flap-resistant)
#   → upstream (Docker Hub / DHI).
# Digests are content-addressed, so the same pin resolves on any mirror.
HUB_REGISTRY=dockerhub.smile.fr
DHI_REGISTRY=dhi.smile.fr

# --- Ollama (containerized GPU service) ------------------------------------
# Ollama runs IN the stack (GPU), reached over the compose network.
OLLAMA_BASE_URL=http://ollama:11434
# Host model store, bind-mounted read-only (238 GB, not re-downloaded). A
# machine whose store lives elsewhere overrides this with a real shell export
# before invoking `scripts/compose` — it is a per-machine fact, not a per-stage
# one (AGENTS.md: never hardcode an absolute path that differs by machine).
OLLAMA_MODELS_DIR=/usr/share/ollama/.ollama/models

# --- Plugin / data roots ---
# Per-machine only insofar as a machine chooses a different relative layout;
# override via shell export, same rule as OLLAMA_MODELS_DIR above.
SWARM_PLUGINS_DIR=./plugins
SWARM_DATA_DIR=./data

# Access model (workspace ADR-20): visibility is Project membership, derived by the KERNEL —
# there is no channel-side group→scope map, no authenticated baseline group and no
# scope-picker any more (the former SWARM_AUTH_BASELINE_GROUP / KNOWN_SOURCE_SCOPES /
# GROUP_SCOPE_MAP knobs are retired; the `staff` cohort is a member of the internal Project
# instead). Optional kernel knobs: SWARM_ELEVATION_TTL_S (default 900),
# SWARM_ELEVATION_MAX_TTL_S (3600), SWARM_DEFAULT_COHORT_GROUP ("staff"; "" disables).

# Image tags for the built services. Bump SWARM_KERNEL_VERSION with the kernel
# release (swarm/scripts/release.sh keeps mix.exs in step); rollback = point it
# back at the previous tag and redeploy.
SWARM_KERNEL_VERSION=0.7.0
SWARM_ML_VERSION=0.2.0
